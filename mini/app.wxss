page { background:#f4f5f7; color:#20252b; font-size:32rpx; } .page { padding:32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); } .card { background:white; padding:28rpx; border-radius:16rpx; margin:24rpx 0; } .title { font-size:44rpx; font-weight:600; margin-bottom:24rpx; } .notice { padding:24rpx; border:2rpx solid #9a6b16; background:#fff6df; color:#563b0b; line-height:1.6; } .muted { color:#505963; line-height:1.6; } .error { color:#a01919; margin:16rpx 0; } .success { color:#205a36; margin:16rpx 0; } input { border:2rpx solid #747e89; border-radius:8rpx; min-height:88rpx; padding:0 20rpx; margin:12rpx 0; background:white; } button { margin:20rpx 0; min-height:92rpx; font-size:32rpx; } .primary { color:white; background:#283f52; } .label { display:block; margin-top:24rpx; } picker { border:2rpx solid #747e89; padding:24rpx; margin:12rpx 0; border-radius:8rpx; } text { overflow-wrap:break-word; } .row { margin:20rpx 0; padding-bottom:20rpx; border-bottom:2rpx solid #d9dde2; }