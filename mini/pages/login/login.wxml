<view class="page"><view class="title">开始记录</view><view class="notice" wx:if="{{mode === 'mock'}}">{{notice}}</view><view class="notice" wx:else>本地开发账号登录，不是微信身份认证。健康记录仍为内存演示。</view><view class="card"><label>本地开发账号登录 <switch checked="{{mode === 'live-auth'}}" disabled="{{busy}}" bindchange="modeChange" aria-label="本地开发账号登录" /></label><block wx:if="{{mode === 'live-auth'}}"><label class="label" for="login">账号</label><input id="login" data-field="login" value="{{login}}" maxlength="100" bindinput="input" aria-label="账号" /><label class="label" for="proof">密码</label><input id="proof" data-field="proof" password value="{{proof}}" maxlength="200" bindinput="input" aria-label="密码" /></block><view class="error" role="alert">{{error}}</view><view class="error">{{noticeFromLogout}}</view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{mode === 'mock' ? '进入演示' : '登录'}}</button></view></view>