<view class="page"><view class="title">手动记录</view><view class="notice">{{notice}}。仅输入虚构资料。</view><view class="card"><view>记录类型</view><picker range="{{kinds}}" value="{{index}}" bindchange="kindChange" disabled="{{busy}}" aria-label="记录类型">{{kinds[index]}} · 点击切换</picker><label class="label" for="first">{{kind === 'weight' ? '体重（kg）' : kind === 'diet' ? '食物名称' : '训练名称'}}</label><input id="first" data-field="first" type="{{kind === 'weight' ? 'digit' : 'text'}}" maxlength="80" value="{{first}}" bindinput="input" disabled="{{busy}}" aria-label="记录数值或名称" /><view class="error">{{errors.first}}</view><block wx:if="{{kind !== 'weight'}}"><label class="label" for="second">{{kind === 'diet' ? '分量说明' : '时长（分钟）'}}</label><input id="second" data-field="second" type="{{kind === 'training' ? 'digit' : 'text'}}" maxlength="80" value="{{second}}" bindinput="input" disabled="{{busy}}" aria-label="分量或分钟数" /><view class="error">{{errors.second}}</view></block><view class="label">记录日期（本机时间）</view><picker mode="date" value="{{date}}" bindchange="dateChange" disabled="{{busy}}" aria-label="记录日期">{{date}}</picker><view class="label">记录时间</view><picker mode="time" value="{{time}}" bindchange="timeChange" disabled="{{busy}}" aria-label="记录时间">{{time}}</picker><view class="error">{{errors.occurredAt}}</view><view class="error" role="alert">{{error}}</view><view class="success" wx:if="{{saved}}">已加入本次演示，未保存到服务器</view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="save">加入演示记录</button><button disabled="{{busy}}" bindtap="back">返回首页</button></view><view class="card"><view>本次演示记录</view><view class="muted" wx:if="{{!items.length}}">暂无记录，请在上方添加一条。</view><view class="row" wx:for="{{items}}" wx:key="id"><view>{{item.label}}</view><view class="muted">{{item.time}}</view></view></view></view>