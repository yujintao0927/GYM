{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "strict": true,
    "lib": [
      "ES2017"
    ],
    "types": [
      "miniprogram-api-typings"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": [
    "app.ts",
    "pages/**/*.ts",
    "services/**/*.ts"
  ]
}